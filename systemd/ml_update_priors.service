[Unit]
Description=ML Bayesian prior updater (weekly)
After=network.target

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=-/home/ubuntu/bot/.env
WorkingDirectory=/home/ubuntu/common
ExecStart=/usr/bin/python3 /home/ubuntu/common/ml_update_priors.py
StandardOutput=append:/home/ubuntu/bot/logs/ml_update_priors.log
StandardError=append:/home/ubuntu/bot/logs/ml_update_priors.log
